# All optional. Defaults shown.
# BRAIN_DIR=./brain              # knowledge, project config, runs, state.sqlite
# BRAIN_PORT=3141
# BRAIN_CONCURRENCY=2            # max Claude sessions at once (subscription rate limits)
# BRAIN_TICK_MS=10000            # scheduler interval
# BRAIN_MAX_TURNS=60
# BRAIN_RUN_TIMEOUT_MIN=30
# BRAIN_MAX_QUESTIONS=5          # per task, then the task parks itself as blocked
# BRAIN_CLAUDE_BIN=claude
# BRAIN_SETTING_SOURCES=project,local   # Claude settings sources for agent runs (user settings excluded)
# Never set ANTHROPIC_API_KEY / ANTHROPIC_AUTH_TOKEN: agents use the owner's subscription login,
# and the runner strips both from the spawned environment anyway.
# BRAIN_MAX_VERIFY_FIXES=2       # failed verify_command → agent gets the output and fixes, this many times
# BRAIN_VERIFY_TIMEOUT_MIN=15
# BRAIN_WORKTREES_DIR=~/.secondbrain/worktrees   # one git worktree per task: <dir>/<project>/<task-id>
# BRAIN_PLAN_COOLDOWN_HOURS=6    # auto_plan: minimum gap between planner tasks of a project
